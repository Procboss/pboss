{
	"name": "pboss",
	"version": "1.1.0",
	"description": "A blazing-fast, full-featured process manager built entirely on Bun native APIs. The modern PM2 replacement — zero Node.js dependencies, pure Bun performance.",
	"main": "src/api.ts",
	"module": "src/api.ts",
	"types": "src/api.ts",
	"exports": {
		".": "./src/api.ts",
		"./cli": "./src/index.ts",
		"./types": "./src/types.ts"
	},
	"bin": {
		"pboss": "./src/index.ts"
	},
	"files": [
		"src/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"start": "bun run src/index.ts",
		"dev": "bun run --watch src/index.ts",
		"test": "bun test",
		"lint": "bun x tsc --noEmit",
		"prepublishOnly": "bun test"
	},
	"keywords": [
		"bun",
		"process-manager",
		"pm2",
		"pm2-alternative",
		"cluster",
		"daemon",
		"production",
		"deployment",
		"monitoring",
		"prometheus",
		"zero-downtime",
		"reload",
		"log-management",
		"health-check",
		"pboss",
		"procboss"
	],
	"author": "procboss.com",
	"license": "GPL-3.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/procboss/pboss.git"
	},
	"bugs": {
		"url": "https://github.com/procboss/pboss/issues"
	},
	"homepage": "https://procboss.com",
	"engines": {
		"bun": ">=1.0.0"
	},
	"os": [
		"linux",
		"darwin",
		"win32"
	],
	"dependencies": {
		"chalk": "^5.6.2",
		"cli-table3": "^0.6.5",
		"pidusage": "^4.0.1"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/pidusage": "^2.0.5",
		"bun-types": "latest",
		"typescript": "^5.9.3"
	}
}
