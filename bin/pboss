0</* :
@echo off
powershell -ExecutionPolicy Bypass -NoProfile -File "%~dp0pboss.ps1" %*
exit /b %errorlevel%
*/0; cat << 'EOF' >/dev/null
#!/bin/sh
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in
    /*) SELF="$LINK" ;;
    *) SELF="$(dirname "$SELF")/$LINK" ;;
  esac
done
DIR="$(CDPATH='' cd -- "$(dirname -- "$SELF")" 2>/dev/null && pwd -P)"
exec "$DIR/pboss.sh" "$@"
EOF
